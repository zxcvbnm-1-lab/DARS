//PURPOSE : PUNGGAN NGA AKSIDENTE MAUPOD SA GIT ANG:

- .env
- API keys
- database credentials
- compiled files 
- node_modules
- build artifacts
- logs
- temporary files

SAFETY LAYER ANG .gitignore FILE PARA SA PAGLIKAY SA PAGKAHILABOT SA SENSITIVE INFORMATION UG PAGPUGONG SA PAGDAGAN SA DAGHANG FILES NGA DILI KINAHANGLAN.

#===========================================================
# Environment & Secrets
#===========================================================
.env
.env.*
!.env.example

#===========================================================
# Java / Spring Boot
#===========================================================
backend/target/
*.class 

#===========================================================
# Node / React 
#===========================================================
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log* 
yarn-debug.log* 
pnpm-debug.log*

#===========================================================
# IDE / Editor
#===========================================================
.vscode/*
!.vscode/extensions.json


.idea/
*.iml

#===========================================================
# Operating System
#===========================================================
.DS_Store
Thumbs.db

#===========================================================
# Logs
#===========================================================
*.log

#===========================================================
# Temporary Files
#===========================================================
*.tmp
*.temp
# Local Spring Boot configuration
backend/application.properties
backend/src/main/resources/application.properties
